# Defaults for the REXL3 engine (rexl3/cluster.sh). The caller's environment wins, then this file, then the repo's .env.
# Byte-exact contract: P1 prefill (prompt rows computed exactly as decode computes them, chunk-grid independent) and the
# fp16 latent KV cache, so every reply equals the unmodified engine's (bench/rexl3/reference.json). P2 prefill and the
# fp8 cache change output bytes and stay off.
SLOTS=8
KV_TOKENS=2097152
MAX_MODEL_LEN=1048576
PREFILL_CHUNK=2048
SPEC=auto
PREFIX_CACHE=off
EXTRA_ARGS=--default-thinking template
REXL3_GLM_PREFILL_CONTRACT=p1
REXL3_GLM_KV=fp16
REXL3_MEMORY_FLOOR_GIB=4
DRAFTS=on
