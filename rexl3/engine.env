# Defaults for the REXL3 engine (rexl3/cluster.sh). The caller's environment wins, then this file, then the repo's .env.
# Contract B (2026-11-07): P2 prefill (prompt rows independent of each other and of the chunk grid, deterministic, but not
# bit-equal to decode rows), the fp8 latent KV cache and the expert width split; every reply equals bench/rexl3/reference.json,
# drafted == serial, concurrent == solo, cached == uncached.
# Prompt cache: snapshots of up to REXL3_GLM_PREFIX_ENTRIES prompts (70 MiB a rank each, plus the drafter's window on rank 0);
# their KV pages are idle pages of the pool, evicted (least recently used) when a sequence needs them. A prompt of at least
# REXL3_PREFIX_MIN_CUT tokens is snapshotted at its end (REXL3_PREFIX_TAIL=0), so the next turn of the conversation reuses it.
# KV_TOKENS caps the pool so that rank 0 keeps >= 4 GiB MemAvailable under load (measured 4.65 GiB at this setting).
SLOTS=8
KV_TOKENS=1179648
MAX_MODEL_LEN=1048576
PREFILL_CHUNK=4096
SPEC=auto
PREFIX_CACHE=on
REXL3_PREFIX_TAIL=0
REXL3_PREFIX_MIN_CUT=1024
REXL3_GLM_PREFIX_ENTRIES=8
EXTRA_ARGS=--default-thinking template
REXL3_GLM_PREFILL_CONTRACT=p2
REXL3_GLM_KV=fp8
REXL3_MEMORY_FLOOR_GIB=4
DRAFTS=on
