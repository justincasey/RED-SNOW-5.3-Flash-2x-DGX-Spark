# Copy to .env and set the two ssh targets. Everything else has a working default.
# Precedence: environment > .env > redsnow.sh defaults.

# ── The two Sparks (key-based ssh from this machine; same user and layout on both) ──
RANK0=spark@spark-a.local            # serves the API
RANK1=spark@spark-b.local

# Where the engine, venv, logs and models go on each node. Empty: $HOME/redsnow and $HOME/redsnow/models.
BASE_DIR=
MODELS_DIR=

# ── Licenses ────────────────────────────────────────────────────────────────
# The DFlash2 drafter (incoai/GLM-5.3-Flash-DFlash2) is CC BY-NC-ND 4.0: research and non-commercial use only.
# yes: you accept those terms and get ~1.5x decode. Or set DRAFTS=off to serve without it.
ACCEPT_DFLASH2_LICENSE=no
DRAFTS=on

# ── Serving ─────────────────────────────────────────────────────────────────
SERVED_NAME=RED-SNOW-5.3-Flash       # the model id clients send
HOST=0.0.0.0                         # rank 0's API bind address
PORT=8080                            # rank 1 uses PORT+1 on localhost
API_KEY=                             # empty: no auth. Set one if the port is reachable beyond your desk.
CONTEXT=131072                       # prompt + reply window (tokens)
KV_DTYPE=fp8                         # fp8 latent KV (per-token scales); bf16 also works, at more memory

# ── The link (normally auto-detected: the RDMA netdevs on both nodes that share a subnet) ──
# Pin all six only if detection picks the wrong pair. Ports may cross (rank 0 f0 <-> rank 1 f1).
# RANK0_IF=enp1s0f0np0
# RANK0_HCA=rocep1s0f0
# RANK0_FABRIC_IP=10.100.0.1
# RANK1_IF=enp1s0f1np1
# RANK1_HCA=rocep1s0f1
# RANK1_FABRIC_IP=10.100.0.2

# ── Advanced (defaults are the measured configuration; see README "Benchmarks") ──
# MEMORY_RESERVE_GIB=2               # memory each rank leaves free
# NCCL_MAX_NCHANNELS=4               # fewer NCCL channels: ~1.5 GiB back for the KV pool
# TF_GLM_EXL3_LOADS=nc2              # MoE decode trellis loads: 0, nc, nc2, nc4
# TF_GLM_HC_SPLIT=1                  # prefill optimizations (1/2/1 on; 0 off)
# TF_GLM_PREFILL_OVERLAP=2
# TF_GLM_KDA_CHUNKED=1
# Any other TF_GLM_*, TF_MOE* or TENSORFOLD_* variable set here is passed to both ranks.

# ── Pins (a release changes these together) ─────────────────────────────────
# TF_REPO=https://github.com/justincasey/TensorFold.git
# TF_REF=redsnow-v1.0.2
# HF_TOKEN=                          # optional: faster, rate-limit-free downloads
