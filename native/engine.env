# Engine settings both ranks start with (native/cluster.sh exports each unless the caller sets it).
# fp8 latent KV (e4m3 rows + fp32 row scale), as the Python recipe served; needle exact at 30K and 59K.
EXTRA_ARGS=--kv-cache fp8
# Default: 2 streams with a ~275K-token window each (67 x 4,096; the model allows 1,048,576). For chat-heavy or
# multi-user serving use PARALLEL=4 CONTEXT=131072 or PARALLEL=8 CONTEXT=65536 (README: Streams vs context).
# autoresearch.sh exports its own CONTEXT=65536 PARALLEL=8, which win over these.
CONTEXT=274432
PARALLEL=2
TENSORFOLD_MEMORY_RESERVE_GIB=6
